# Medialane App Environment Variables

NEXT_PUBLIC_APP_URL=https://starknet.medialane.io
# ── Contracts ────────────────────────────────────────────────────────────────
# Marketplace contract addresses are sourced from @medialane/sdk.
# Do not add dapp env overrides for marketplace contracts.
NEXT_PUBLIC_EXPLORER_URL=https://voyager.online
# ── Starknet RPC ──────────────────────────────────────────────────────────────
# Not read by this app. Chain access goes through /api/rpc, which forwards to
# the backend's metered /v1/rpc; the upstream node URL lives only in
# medialane-backend. Kept here only as a note for anyone looking for it.

NEXT_PUBLIC_MEDIALANE_BACKEND_URL=https://api.medialane.io
# Server-only: injected by /api/proxy and other server routes, never sent to the browser.
MEDIALANE_API_KEY=

# ── Platform fees ─────────────────────────────────────────────────────────────
# Defaults when unset: enabled, 100 bps (1%) on every surface. Fee calls are
# skipped entirely unless the fund address is set.
NEXT_PUBLIC_FEE_ENABLED=true
NEXT_PUBLIC_FEE_FUND_ADDRESS=
NEXT_PUBLIC_FEE_MARKETPLACE_BPS=100
NEXT_PUBLIC_FEE_LAUNCHPAD_BPS=100

# ── Media ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PINATA_GATEWAY=

# ── Genesis claim ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GENESIS_NFT_URI=
NEXT_PUBLIC_GENESIS_NFT_IMAGE_URL=

# ── Indexing ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_COLLECTION_721_START_BLOCK=
