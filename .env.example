# Medialane App Environment Variables

NEXT_PUBLIC_APP_URL=https://starknet.medialane.io

# ── Contracts ────────────────────────────────────────────────────────────────
# Marketplace contract addresses are sourced from @medialane/sdk.
# Do not add dapp env overrides for marketplace contracts.
NEXT_PUBLIC_COLLECTION_721_CONTRACT=0x0322cb7119955e01ac778d40976eb3ba50540bb0899f812d612f9c7e63e49fd2
NEXT_PUBLIC_COLLECTION_721_START_BLOCK=10046166
NEXT_PUBLIC_COLLECTION_1155_CONTRACT=0x067064adcaaed61e17bf50ea802ea6482336126aec5b4d032b4ff8fbb5009131
NEXT_PUBLIC_NFTCOMMENTS_CONTRACT=0x02cdac70c94447189af0389dfea63f4d5e4154ea8a563de288a5ab1c39e37843

NEXT_PUBLIC_STARKNET_NETWORK=mainnet

NEXT_PUBLIC_EXPLORER_URL=https://voyager.online

# ── Starknet RPC ──────────────────────────────────────────────────────────────
# Browser RPC calls go through the same-origin proxy so the Alchemy key stays
# server-side. Keep the keyed Alchemy URL in ALCHEMY_RPC_URL (server-only) ONLY.
NEXT_PUBLIC_STARKNET_PROVIDER_URL=/api/rpc
# Keyless public fallback for local dev / when the proxy is unset (e.g. lava).
# Chain-named standard — NEVER put a keyed provider URL in any NEXT_PUBLIC_ var
# (its value is inlined into the client bundle). Replaces the legacy bare
# NEXT_PUBLIC_RPC_URL.
NEXT_PUBLIC_STARKNET_RPC_URL=
# Server-only: the keyed Alchemy endpoint the /api/rpc proxy forwards to (primary).
ALCHEMY_RPC_URL=
# NEXT_PUBLIC_ALCHEMY_API_KEY is no longer required — token/collection reads use the Medialane backend API

# ── Medialane Backend API ─────────────────────────────────────────────────────
NEXT_PUBLIC_MEDIALANE_BACKEND_URL=https://api.medialane.io
NEXT_PUBLIC_MEDIALANE_API_KEY=

NEXT_PUBLIC_STARKNET_USDC=0x033068F6539f8e6e6b131e6B2B814e6c34A5224bC66947c47DaB9dFeE93b35fb
NEXT_PUBLIC_STARKNET_STRK=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
NEXT_PUBLIC_STARKNET_WBTC=0x03fe2b97c1fd336e750087d68b9b867997fd64a2661ff3ca5a7c771641e8e7ac

NEXT_PUBLIC_GATEWAY_URL=https://ipfs.io/ipfs
PINATA_JWT=
PINATA_SECRET=
PINATA_API_KEY=
NEXT_PUBLIC_PINATA_HOST=https://ipfs.io
PINATA_HOST=https://ipfs.io/ipfs

# ── StarkZap ──────────────────────────────────────────────────────────────────
# AVNU Paymaster API key for sponsored / gasless transactions (optional)
NEXT_PUBLIC_AVNU_PAYMASTER_API_KEY=
